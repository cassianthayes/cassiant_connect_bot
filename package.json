{
  "name": "cassiant-connect-bot",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "bun check",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cassiant-connect-bot --local",
    "db:migrate": "wrangler d1 migrations apply cassiant-connect-bot --remote",
    "webhook": "bun --env-file=.dev.vars scripts/set-webhook.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "node-telegram-bot-api": "^2.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
