{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cassiant-connect-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cassiant-connect-bot",
      "database_id": "52737f24-2ca7-4fc7-a046-095cd75b4b64",
      "migrations_dir": "drizzle",
    },
  ],
  // Secrets (wrangler secret put <NAME>, or .dev.vars locally):
  //   BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, REMNAWAVE_TOKEN, REMNAWAVE_WEBHOOK_SECRET
  "vars": {
    "ADMIN_ID": 8510458463,
    // group for the event log; add the bot to it
    "LOG_CHAT_ID": -1003909395509,
    "REMNAWAVE_URL": "https://rw.cssnt.ru",
    "REMNAWAVE_SQUADS": ["76d88900-be4a-4317-8ad8-d1a805cb3c0e"],
    // days -> price in Telegram Stars
    "PLANS": {
      "1": 5,
      "7": 30,
      "14": 50,
      "30": 100,
      "90": 250,
    },
  },
}
